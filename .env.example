# Caminho do binário claude. Default: $HOME/.local/bin/claude
CLAUDE_BIN=

# Ativa o skip de chamadas quando já existe sessão ativa recente. Default: true
ENABLE_SESSION_SKIP=

# Janela (minutos) considerada "sessão ativa" desde a última chamada. Default: 300
SESSION_WINDOW_MINUTES=

# Arquivo usado como sinal de atividade recente do usuário no Claude Code. Default: $HOME/.claude/history.jsonl
CLAUDE_ACTIVITY_FILE=

# Tamanho máximo (bytes) do claude-cron.log antes de rotacionar para claude-cron.log.1. Default: 1048576 (1MB)
LOG_MAX_BYTES=

# Quando o script encontra sessão já ativa, intervalo (minutos) entre cada
# nova tentativa de iniciar, até MAX_RETRIES. Default: 5
RETRY_INTERVAL_MINUTES=

# Nº máximo de tentativas (a 1ª + os retries) antes de desistir e devolver
# o controle pro próximo tick do cron. Default: 12 (12 x 5min = ~55min de
# cobertura, pra pegar sessões que estão quase expirando).
MAX_RETRIES=

# --- Usadas só pelo install-cron.sh, pra gerar a linha do crontab ---
# Os ticks ficam espaçados por SESSION_WINDOW_MINUTES (acima), começando em
# CRON_START_HOUR:CRON_START_MINUTE e sem passar de CRON_END_HOUR. Ex, com os
# defaults abaixo (5h30, passo de 5h, até 21h): 05:30, 10:30, 15:30, 20:30.

# Hora de início do primeiro tick (0-23). Default: 5
CRON_START_HOUR=

# Minuto fixo de todos os ticks (0-59). Default: 30
CRON_START_MINUTE=

# Hora máxima permitida pro último tick (0-23, inclusive). Default: 21
CRON_END_HOUR=
