# Caminho do binário claude. Default: $HOME/.local/bin/claude
CLAUDE_BIN=

# Modelo usado pra abrir a sessão (barato de propósito).
# Default: claude-haiku-4-5-20251001
CLAUDE_MODEL=

# Duração da janela de sessão em minutos. Default: 300 (5h)
SESSION_WINDOW_MINUTES=

# Folga (segundos) pra considerar a sessão anterior encerrada, já que o cron
# dispara alguns segundos antes do fim exato da janela. Default: 120
SESSION_GRACE_SECONDS=

# Banco sqlite com o histórico de sessões. Default: ./sessions.db
DB_FILE=
